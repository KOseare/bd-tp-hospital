# Configuración de conexión a Oracle (modo thin de python-oracledb, no requiere Instant Client).
# Copiá este archivo como ".env" y completá tus credenciales.
#
# Si no creás ".env", la aplicación abrirá una ventana de login pidiendo usuario y contraseña
# usando por defecto localhost:1521/FREEPDB1.

HOSPITAL_USER=
HOSPITAL_PASSWORD=
# En Oracle Free suele ser localhost:1521/FREEPDB1; en Oracle XE suele ser 127.0.0.1:1521/XEPDB1
HOSPITAL_DSN=localhost:1521/FREEPDB1
